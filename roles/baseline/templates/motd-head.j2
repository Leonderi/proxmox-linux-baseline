{#- Statischer Teil des MOTD: Banner "tk-thran" kompakt mit den wichtigsten Angaben rechts
    daneben (entschieden 2026-11-06), darunter Dienste, Web und Doku aus NetBox.
    Farb-Platzhalter ersetzt /usr/local/lib/tk/motd-render: @P@ Firmen-Lila, @L@ Label,
    @V@ Wert, @T@ Text, @D@ gedimmt, @R@ zuruecksetzen. -#}
{%- set h = nb | default({}) -%}
{%- set name = h.name | default(inventory_hostname) -%}
{%- set svc = h.services | default([]) -%}
{%- set backup = 'kein Backup (Testsystem)' if h.env | default('') == 'tst' else baseline_backup -%}
{%- set desc = h.description | default('') -%}
{%- set desc = (desc[:43] ~ '…') if desc | length > 44 else desc -%}
@P@  __  __       __  __               @R@  @V@{{ name }}@R@ @D@·@R@ {{ h.typ | default('?') }} {{ h.vmid | default('?') }}
@P@ / /_/ /______/ /_/ /  _______ ____ @R@  {{ h.zone | default('?') }}{% if h.vlan %} (VLAN {{ h.vlan }}){% endif %} @D@·@R@ {{ h.ip | default(ansible_host | default('')) }}
@P@/ __/  '_/___/ __/ _ \/ __/ _ `/ _ \@R@  {{ h.class | default('–', true) }} @D@·@R@ {{ backup }}
@P@\__/_/\_\    \__/_//_/_/  \_,_/_//_/@R@  @T@{{ desc }}@R@

{% for s in svc[:6] %}
  @L@{{ 'Dienste' if loop.first else '       ' }}@R@  {{ s.name }}{% if s.ports %} @D@:{{ s.ports | join(',') }}@R@{% endif %}

{% endfor %}
{% if svc | length > 6 %}
           @D@… und {{ svc | length - 6 }} weitere, tk info@R@
{% endif %}
{% for f in h.fqdns | default([]) %}
  @L@{{ 'Web    ' if loop.first else '       ' }}@R@  https://{{ f }}
{% endfor %}
  @L@Doku   @R@  {{ (baseline_doku_url ~ '/infrastructure/hosts/' ~ name) | regex_replace('^https://', '') }}
